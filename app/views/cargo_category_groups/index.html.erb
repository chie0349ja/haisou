<% content_for :title, "荷物カテゴリグループ" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">荷物カテゴリグループ</h1>
    <p class="mt-1 text-sm text-slate-500">表のセルを直接編集して一括保存できます。</p>
  </div>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: CargoCategoryGroup,
             bulk_path: bulk_update_cargo_category_groups_path,
             deletable: true,
             columns: [
               { key: :name, label: "グループ名" },
               { key: :sort_order, label: "表示順", type: :number }
             ] %>
</div>
