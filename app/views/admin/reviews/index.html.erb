<% content_for :title, "仮登録審査" %>
<div>
  <h1 class="text-3xl font-bold">仮登録審査</h1>
  <p class="mt-1 text-slate-500">コードを付与して正式化するか、既存データへ統合します。</p>

  <% [["取引先", @pending_clients, "client", Client.where(pending_review: false, active: true)], ["店舗", @pending_stores, "store", Store.where(pending_review: false, active: true)]].each do |label, records, type, targets| %>
    <section class="mt-8">
      <h2 class="text-xl font-bold"><%= label %></h2>
      <div class="mt-3 overflow-x-auto rounded-xl border bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left"><tr><th class="px-4 py-3">名称</th><th class="px-4 py-3">登録者</th><th class="px-4 py-3">正式化</th><th class="px-4 py-3">既存へ統合</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% records.each do |record| %>
              <tr>
                <td class="px-4 py-3 font-medium"><%= record.name %><% if record.respond_to?(:client) && record.client %><br><span class="font-normal text-slate-500"><%= record.client.name %></span><% end %></td>
                <td class="px-4 py-3"><%= record.created_by&.name || "不明" %></td>
                <td class="px-4 py-3">
                  <%= form_with url: approve_admin_review_path(record, type: type), method: :patch, class: "flex gap-2" do |form| %>
                    <%= form.text_field :code, required: true, placeholder: "正式コード", class: "w-36 rounded-lg border-slate-300" %>
                    <%= form.submit "正式化", class: "rounded-lg bg-emerald-600 px-3 py-2 text-white cursor-pointer" %>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <%= form_with url: merge_admin_review_path(record, type: type), method: :post, class: "flex gap-2", data: { turbo_confirm: "参照先を付け替えて統合します。よろしいですか？" } do |form| %>
                    <%= form.collection_select :target_id, targets.order(:name), :id, :name, { prompt: "統合先を選択" }, required: true, class: "rounded-lg border-slate-300" %>
                    <%= form.submit "統合", class: "rounded-lg bg-amber-600 px-3 py-2 text-white cursor-pointer" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if records.empty? %><p class="p-8 text-center text-slate-500">審査待ちはありません。</p><% end %>
      </div>
    </section>
  <% end %>
</div>
