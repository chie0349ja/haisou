<% content_for :title, "按分比率" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">按分比率</h1>
    <p class="mt-1 text-sm text-slate-500">表のセルを直接編集して一括保存できます。</p>
  </div>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: AllocationRatio,
             bulk_path: bulk_update_allocation_ratios_path,
             deletable: true,
             columns: [
               { key: :cargo_category_group_id, label: "荷物カテゴリグループ", type: :select, choices: @cargo_category_groups.map { |group| [group.name, group.id] } },
               { key: :ratio, label: "比率", type: :number, step: "0.0001", min: 0, max: 1 },
               { key: :effective_from, label: "適用開始日", type: :date },
               { key: :effective_to, label: "適用終了日", type: :date }
             ] %>
</div>
