<%= form_with(model: allocation_ratio, class: "contents") do |form| %>
  <% if allocation_ratio.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(allocation_ratio.errors.count, "error") %> prohibited this allocation_ratio from being saved:</h2>

      <ul class="list-disc ml-6">
        <% allocation_ratio.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :cargo_category_group_id %>
    <%= form.text_field :cargo_category_group_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": allocation_ratio.errors[:cargo_category_group_id].none?, "border-red-400 focus:outline-red-600": allocation_ratio.errors[:cargo_category_group_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :ratio %>
    <%= form.text_field :ratio, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": allocation_ratio.errors[:ratio].none?, "border-red-400 focus:outline-red-600": allocation_ratio.errors[:ratio].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :effective_from %>
    <%= form.date_field :effective_from, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": allocation_ratio.errors[:effective_from].none?, "border-red-400 focus:outline-red-600": allocation_ratio.errors[:effective_from].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :effective_to %>
    <%= form.date_field :effective_to, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": allocation_ratio.errors[:effective_to].none?, "border-red-400 focus:outline-red-600": allocation_ratio.errors[:effective_to].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
