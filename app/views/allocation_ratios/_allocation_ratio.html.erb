<div id="<%= dom_id allocation_ratio %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Cargo category group:</strong>
    <%= allocation_ratio.cargo_category_group_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Ratio:</strong>
    <%= allocation_ratio.ratio %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Effective from:</strong>
    <%= allocation_ratio.effective_from %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Effective to:</strong>
    <%= allocation_ratio.effective_to %>
  </div>
</div>
