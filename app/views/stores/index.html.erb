<% content_for :title, "店舗" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">店舗</h1>
    <p class="mt-1 text-sm text-slate-500"><%= current_user.admin? ? "表のセルを直接編集して一括保存できます。" : "登録済みの店舗を確認できます。" %></p>
  </div>
  <%= form_with url: stores_path, method: :get, class: "flex flex-col gap-2 sm:flex-row" do |form| %>
    <%= form.collection_select :client_id, @clients, :id, :name, { include_blank: "すべての取引先", selected: params[:client_id] }, aria: { label: "取引先で絞り込み" }, class: "w-full rounded-lg border-slate-300 text-sm sm:max-w-xs" %>
    <%= form.search_field :q, value: params[:q], placeholder: "名称をあいまい検索", aria: { label: "店舗名をあいまい検索" }, class: "w-full rounded-lg border-slate-300 text-sm sm:max-w-lg" %>
    <%= form.submit "絞り込む", class: "rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  <% end %>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: Store,
             bulk_path: bulk_update_stores_path,
             editable: current_user.admin?,
             columns: [
               { key: :client_id, label: "取引先", type: :select, choices: @clients.map { |client| [client.name, client.id] } },
               { key: :code, label: "店舗コード" },
               { key: :name, label: "店舗名" },
               { key: :pending_review, label: "審査状態", type: :badge },
               { key: :active, label: "有効", type: :checkbox }
             ] %>
</div>
