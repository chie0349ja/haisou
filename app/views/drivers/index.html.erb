<% content_for :title, "ドライバー" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">ドライバー</h1>
    <p class="mt-1 text-sm text-slate-500">表のセルを直接編集して一括保存できます。</p>
  </div>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: Driver,
             bulk_path: bulk_update_drivers_path,
             columns: [
               { key: :code, label: "ドライバーコード" },
               { key: :name, label: "ドライバー名" },
               { key: :delivery_company_id, label: "配送会社", type: :select, choices: @delivery_companies.map { |company| [company.name, company.id] } },
               { key: :active, label: "有効", type: :checkbox },
               { key: :sort_order, label: "表示順", type: :number }
             ] %>
</div>
