<%= form_with(model: driver, class: "contents") do |form| %>
  <% if driver.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(driver.errors.count, "error") %> prohibited this driver from being saved:</h2>

      <ul class="list-disc ml-6">
        <% driver.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :code %>
    <%= form.text_field :code, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": driver.errors[:code].none?, "border-red-400 focus:outline-red-600": driver.errors[:code].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": driver.errors[:name].none?, "border-red-400 focus:outline-red-600": driver.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :delivery_company_id %>
    <%= form.text_field :delivery_company_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": driver.errors[:delivery_company_id].none?, "border-red-400 focus:outline-red-600": driver.errors[:delivery_company_id].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :active %>
    <%= form.check_box :active, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": driver.errors[:active].none?, "border-red-400 focus:outline-red-600": driver.errors[:active].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :sort_order %>
    <%= form.number_field :sort_order, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": driver.errors[:sort_order].none?, "border-red-400 focus:outline-red-600": driver.errors[:sort_order].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
