<% content_for :title, "荷物カテゴリ" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">荷物カテゴリ</h1>
    <p class="mt-1 text-sm text-slate-500">表のセルを直接編集して一括保存できます。</p>
  </div>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: CargoCategory,
             bulk_path: bulk_update_cargo_categories_path,
             columns: [
               { key: :code, label: "カテゴリコード" },
               { key: :name, label: "カテゴリ名" },
               { key: :cargo_category_group_id, label: "グループ", type: :select, choices: @cargo_category_groups.map { |group| [group.name, group.id] } },
               { key: :active, label: "有効", type: :checkbox },
               { key: :sort_order, label: "表示順", type: :number }
             ] %>
</div>
