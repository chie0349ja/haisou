<div id="<%= dom_id delivery_record %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Service date:</strong>
    <%= delivery_record.service_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= delivery_record.course_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Delivery company:</strong>
    <%= delivery_record.delivery_company_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Vehicle:</strong>
    <%= delivery_record.vehicle_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Driver:</strong>
    <%= delivery_record.driver_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Cargo category:</strong>
    <%= delivery_record.cargo_category_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= delivery_record.client_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Store:</strong>
    <%= delivery_record.store_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Volume:</strong>
    <%= delivery_record.volume %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Unit:</strong>
    <%= delivery_record.unit_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Departure at:</strong>
    <%= delivery_record.departure_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Arrival at:</strong>
    <%= delivery_record.arrival_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Created by:</strong>
    <%= delivery_record.created_by_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Updated by:</strong>
    <%= delivery_record.updated_by_id %>
  </div>
</div>
