<%= form_with(model: delivery_record, class: "space-y-6", data: { controller: "delivery-form" }) do |form| %>
  <% if delivery_record.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>入力内容を確認してください</h2>

      <ul class="list-disc ml-6">
        <% delivery_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% field_class = "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
  <div class="grid gap-5 md:grid-cols-2">
    <div><%= form.label :service_date, "運行日", class: "font-medium" %><%= form.date_field :service_date, class: field_class, required: true %></div>
    <div><%= form.label :course_id, "コース", class: "font-medium" %><%= form.collection_select :course_id, @courses, :id, :name, { prompt: "選択してください" }, class: field_class, required: true %></div>
    <div><%= form.label :delivery_company_id, "配送会社", class: "font-medium" %><%= form.collection_select :delivery_company_id, @delivery_companies, :id, :name, { prompt: "選択してください" }, class: field_class, required: true %></div>
    <div><%= form.label :vehicle_id, "車両", class: "font-medium" %><%= form.collection_select :vehicle_id, @vehicles, :id, :code, { prompt: "選択してください" }, class: field_class, required: true %></div>
    <div><%= form.label :driver_id, "ドライバー", class: "font-medium" %><%= form.collection_select :driver_id, @drivers, :id, :name, { prompt: "選択してください" }, class: field_class, required: true %></div>
    <div><%= form.label :cargo_category_id, "荷物カテゴリ", class: "font-medium" %><%= form.collection_select :cargo_category_id, @cargo_categories, :id, :name, { prompt: "選択してください" }, class: field_class, required: true %></div>

    <div class="relative">
      <%= form.label :client_id, "取引先", class: "font-medium" %>
      <div class="flex gap-2">
        <input value="<%= delivery_record.client&.name %>" data-delivery-form-target="clientInput" data-action="input->delivery-form#searchClient" class="<%= field_class %>" autocomplete="off" placeholder="名称を入力して検索">
        <button type="button" data-kind="client" data-action="delivery-form#openQuick" class="mt-1 shrink-0 rounded-lg bg-slate-200 px-3">新規</button>
      </div>
      <%= form.hidden_field :client_id, data: { delivery_form_target: "clientId" } %>
      <div data-delivery-form-target="clientResults" class="absolute z-10 mt-1 hidden w-full rounded-lg border bg-white shadow-lg"></div>
    </div>

    <div class="relative">
      <%= form.label :store_id, "店舗（任意）", class: "font-medium" %>
      <div class="flex gap-2">
        <input value="<%= delivery_record.store&.name %>" data-delivery-form-target="storeInput" data-action="input->delivery-form#searchStore" class="<%= field_class %>" autocomplete="off" placeholder="名称を入力して検索">
        <button type="button" data-kind="store" data-action="delivery-form#openQuick" class="mt-1 shrink-0 rounded-lg bg-slate-200 px-3">新規</button>
      </div>
      <%= form.hidden_field :store_id, data: { delivery_form_target: "storeId" } %>
      <div data-delivery-form-target="storeResults" class="absolute z-10 mt-1 hidden w-full rounded-lg border bg-white shadow-lg"></div>
    </div>

    <div><%= form.label :volume, "物量", class: "font-medium" %><%= form.number_field :volume, min: 0.01, step: 0.01, class: field_class, required: true %></div>
    <div><%= form.label :unit_id, "単位", class: "font-medium" %><%= form.collection_select :unit_id, @units, :id, :name, { prompt: "選択してください" }, class: field_class, required: true %></div>
    <div><%= form.label :departure_at, "出発日時", class: "font-medium" %><%= form.datetime_local_field :departure_at, class: field_class, required: true %></div>
    <div><%= form.label :arrival_at, "到着日時（任意）", class: "font-medium" %><%= form.datetime_local_field :arrival_at, class: field_class %></div>
  </div>

  <div class="inline">
    <%= form.submit "配送実績を保存", class: "w-full sm:w-auto rounded-lg px-5 py-3 bg-sky-600 hover:bg-sky-500 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <dialog data-delivery-form-target="dialog" class="m-auto w-full max-w-md rounded-xl p-0 shadow-2xl backdrop:bg-black/40">
    <div class="p-6">
      <h2 data-delivery-form-target="dialogTitle" class="text-xl font-bold"></h2>
      <label class="mt-4 block font-medium">名称</label>
      <input data-delivery-form-target="quickName" class="<%= field_class %>">
      <p data-delivery-form-target="quickError" class="mt-2 text-sm text-red-600"></p>
      <p class="mt-2 text-sm text-slate-500">管理者の確認待ちとして登録されます。</p>
      <div class="mt-5 flex justify-end gap-2">
        <button type="button" data-action="delivery-form#closeQuick" class="rounded-lg px-4 py-2">キャンセル</button>
        <button type="button" data-action="delivery-form#saveQuick" class="rounded-lg bg-sky-600 px-4 py-2 text-white">仮登録</button>
      </div>
    </div>
  </dialog>
<% end %>
