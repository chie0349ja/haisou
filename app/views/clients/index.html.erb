<% content_for :title, "取引先" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">取引先</h1>
    <p class="mt-1 text-sm text-slate-500"><%= current_user.admin? ? "表のセルを直接編集して一括保存できます。" : "登録済みの取引先を確認できます。" %></p>
  </div>
  <%= form_with url: clients_path, method: :get, class: "flex flex-col gap-2 sm:flex-row" do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "名称をあいまい検索", aria: { label: "取引先名をあいまい検索" }, class: "w-full max-w-lg rounded-lg border-slate-300 text-sm" %>
    <%= form.submit "検索", class: "rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  <% end %>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: Client,
             bulk_path: bulk_update_clients_path,
             editable: current_user.admin?,
             columns: [
               { key: :code, label: "取引先コード" },
               { key: :name, label: "取引先名" },
               { key: :pending_review, label: "審査状態", type: :badge },
               { key: :active, label: "有効", type: :checkbox }
             ] %>
</div>
