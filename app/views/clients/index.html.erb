<% content_for :title, "取引先" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-3xl">取引先</h1>
    <% if current_user.admin? %><%= link_to "取引先を登録", new_client_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %><% end %>
  </div>
  <%= form_with url: clients_path, method: :get, class: "my-5 flex gap-2" do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "名称をあいまい検索", class: "w-full max-w-lg rounded-lg border-slate-300" %>
    <%= form.submit "検索", class: "rounded-lg bg-slate-800 px-4 py-2 text-white" %>
  <% end %>

  <div id="clients" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @clients.any? %>
      <% @clients.each do |client| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render client %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "詳細", client, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <% if current_user.admin? %><%= link_to "編集", edit_client_path(client), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %><% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No clients found.</p>
    <% end %>
  </div>
</div>
