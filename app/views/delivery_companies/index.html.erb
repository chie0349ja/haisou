<% content_for :title, "配送会社" %>

<div class="w-full space-y-5">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">配送会社</h1>
    <p class="mt-1 text-sm text-slate-500">表のセルを直接編集して一括保存できます。</p>
  </div>

  <%= render "shared/bulk_table",
             records: @bulk_records,
             model_class: DeliveryCompany,
             bulk_path: bulk_update_delivery_companies_path,
             columns: [
               { key: :code, label: "配送会社コード" },
               { key: :name, label: "配送会社名" },
               { key: :active, label: "有効", type: :checkbox },
               { key: :sort_order, label: "表示順", type: :number }
             ] %>
</div>
